# UVL configuration — copy to .env.local (dev) or .env.production and fill in.
# Generate secrets with: ./infra/scripts/generate-secrets.sh >> .env.local

# ── Deployment mode ───────────────────────────────────────────────
UVL_DEPLOYMENT_MODE=local          # local | production
UVL_DEBUG=True                     # True in dev, False in prod
UVL_LOG_LEVEL=DEBUG                # DEBUG | INFO | WARNING | ERROR

# ── Django core ───────────────────────────────────────────────────
UVL_SECRET_KEY=change-me-generate-with-scripts
UVL_ALLOWED_HOSTS=localhost,127.0.0.1
UVL_CSRF_TRUSTED_ORIGINS=http://localhost:8003,http://localhost:5173
UVL_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Auth ──────────────────────────────────────────────────────────
UVL_JWT_SIGNING_KEY=change-me-generate-with-scripts
UVL_ADMIN_EMAIL=admin@uvl.local
UVL_ADMIN_PASSWORD=change-me-on-first-login

# ── At-rest encryption (Fernet) ───────────────────────────────────
UVL_FERNET_KEY=change-me-generate-with-scripts
# Optional second key for rotation; decrypt uses both, encrypt uses current
UVL_FERNET_KEY_PREV=

# ── Worker ↔ Django shared bearer ─────────────────────────────────
# The asyncio worker uses this token to post state-change callbacks
# (e.g. mark-adopted). Must be set on BOTH the Django and worker
# containers in production. If empty, callback endpoints 403.
UVL_WORKER_TOKEN=

# ── Postgres ──────────────────────────────────────────────────────
UVL_DATABASE_URL=postgres://uvl:uvl@postgres:5432/uvl

# ── Redis ─────────────────────────────────────────────────────────
UVL_REDIS_URL=redis://redis:6379/0
UVL_CELERY_BROKER_URL=redis://redis:6379/1
UVL_CHANNELS_LAYER_URL=redis://redis:6379/2

# ── Blob storage ──────────────────────────────────────────────────
UVL_BLOB_BACKEND=filesystem        # filesystem | s3
UVL_BLOB_PATH=/var/lib/uvl/blobs

# Required when UVL_BLOB_BACKEND=s3
UVL_MINIO_ENDPOINT=http://minio:9000
UVL_MINIO_ACCESS_KEY=
UVL_MINIO_SECRET_KEY=
UVL_MINIO_FIRMWARE_BUCKET=uvl-firmware

# ── Observability (optional) ──────────────────────────────────────
UVL_OTEL_EXPORTER_OTLP_ENDPOINT=
UVL_SENTRY_DSN=
