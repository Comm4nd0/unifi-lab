{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uvl.example.com/schemas/blueprint.v1.json",
  "title": "UVL Blueprint v1",
  "description": "Declarative description of a UniFi site — VLANs, WLANs, devices, traffic profiles. Phase 2 MVP covers the structural shape; richer semantic validation lives in apps.blueprints.services.validator.",
  "type": "object",
  "required": ["schema_version", "name", "site"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["uvl-blueprint/v1"]
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "description": { "type": "string", "maxLength": 4096 },
    "labels": {
      "type": "array",
      "items": { "type": "string", "maxLength": 50 },
      "uniqueItems": true
    },
    "site": {
      "type": "object",
      "required": ["devices"],
      "additionalProperties": false,
      "properties": {
        "networks": { "type": "array", "items": { "$ref": "#/$defs/network" } },
        "wlans": { "type": "array", "items": { "$ref": "#/$defs/wlan" } },
        "devices": { "type": "array", "items": { "$ref": "#/$defs/device" } },
        "clients": { "type": "array", "items": { "$ref": "#/$defs/client" } },
        "traffic_profiles": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    }
  },
  "$defs": {
    "network": {
      "type": "object",
      "required": ["name", "vlan"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "vlan": { "type": "integer", "minimum": 1, "maximum": 4094 },
        "subnet": {
          "type": "string",
          "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"
        },
        "purpose": { "type": "string", "maxLength": 32 }
      }
    },
    "wlan": {
      "type": "object",
      "required": ["ssid", "network"],
      "additionalProperties": false,
      "properties": {
        "ssid": { "type": "string", "minLength": 1, "maxLength": 32 },
        "network": { "type": "string", "description": "Network name (must resolve in blueprint.site.networks)" },
        "security": {
          "type": "string",
          "enum": ["open", "wpa2", "wpa3", "wpa2-wpa3"],
          "default": "wpa2"
        },
        "passphrase": { "type": "string", "minLength": 8, "maxLength": 63 },
        "hide_ssid": { "type": "boolean", "default": false }
      }
    },
    "device": {
      "type": "object",
      "required": ["hostname", "model"],
      "additionalProperties": false,
      "properties": {
        "hostname": { "type": "string", "minLength": 1, "maxLength": 64 },
        "model": { "type": "string", "description": "model_code matching a DeviceTemplate (e.g. USW24P250, U6-Pro)" },
        "role": {
          "type": "string",
          "enum": ["gateway", "switch", "access-point", "other"],
          "description": "Optional — the model's device_family implies this; override only when needed"
        },
        "mac": {
          "type": "string",
          "pattern": "^([0-9a-f]{2}:){5}[0-9a-f]{2}$",
          "description": "Optional; auto-generated (deterministic from slug+hostname) when omitted"
        },
        "uplink": { "type": "string", "description": "Hostname of parent switch/gateway" },
        "network": { "type": "string", "description": "Primary network name" }
      }
    },
    "client": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 64 },
        "count": { "type": "integer", "minimum": 1, "maximum": 1024, "default": 1 },
        "network": { "type": "string" },
        "wlan": { "type": "string" },
        "mac_prefix": {
          "type": "string",
          "pattern": "^([0-9a-f]{2}:){2,5}[0-9a-f]{2}$"
        }
      }
    }
  }
}
